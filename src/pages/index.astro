---
import Layout from '../layouts/Layout.astro';
import { PortfolioPage } from '../components/templates/PortfolioPage';
import { portfolioData } from '../data/portfolio';
---

<Layout
	title={`${portfolioData.name} | ${portfolioData.role}`}
	description="Portafolio profesional de desarrollo Java con proyectos, tecnologias y enfoque en escalabilidad."
>
	<PortfolioPage client:load data={portfolioData} />
</Layout>
